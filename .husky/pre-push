#!/usr/bin/env sh
# Быстрое AI-ревью перед пушем. Не блокирует пуш, только печатает отчёт.
# Для альтернативного стека замените вызов на `opencode run "..."`.

DIFF=$(git diff origin/main...HEAD --stat)

if [ -z "$DIFF" ]; then
  echo "Нет изменений относительно main, пропускаем AI-ревью."
  exit 0
fi

claude --print "Проведи быстрое ревью изменений. Верни критичные проблемы и 1-2 рекомендации. Diff:
$DIFF"
